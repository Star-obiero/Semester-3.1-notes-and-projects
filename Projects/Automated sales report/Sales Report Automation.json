      "id": "490c8b30-e870-48be-ad7c-06c44c67d191",
      "name": "Summarize",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        -1232,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst rows = $('Get row(s) in sheet').all().map(item => item.json);\n\n// Change these field names if your dataset uses different names.\nconst FIELD = {\n  orderId: 'order_id',\n  date: 'date',\n  product: 'product',\n  quantity: 'quantity',\n  price: 'unit_price',\n  discount: 'discount_pct',\n  cost: 'unit_cost',\n};\n\nconst now = new Date();\nconst DAY = 24 * 60 * 60 * 1000;\n\nconst currentStart = new Date(now.getTime() - 7 * DAY);\nconst previousStart = new Date(now.getTime() - 14 * DAY);\n\nconst money = n => Math.round(n * 100) / 100;\n\nfunction number(value, fallback = 0) {\n  if (value === null || value === undefined || value === '') {\n    return fallback;\n  }\n\n  const n = Number(value);\n  return Number.isFinite(n) ? n : fallback;\n}\n\n// Calculate discounted revenue and gross profit for each row.\nconst lines = rows.map(row => {\n  const quantity = number(row[FIELD.quantity]);\n  const price = number(row[FIELD.price]);\n  const discount = number(row[FIELD.discount]);\n\n  if (discount < 0 || discount > 100) {\n    throw new Error('Discount must be between 0 and 100%.');\n  }\n\n  const revenue = quantity * price * (1 - discount / 100);\n\n  const hasCost =\n    row[FIELD.cost] !== null &&\n    row[FIELD.cost] !== undefined &&\n    row[FIELD.cost] !== '';\n\n  const cost = hasCost\n    ? quantity * number(row[FIELD.cost])\n    : null;\n\n  const date = new Date(row[FIELD.date]);\n\n  return {\n    ...row,\n    _date: date,\n    _revenue: revenue,\n    _cost: cost,\n    _profit: cost === null ? null : revenue - cost,\n  };\n});\n\n// Keep the current and previous seven-day windows separate.\nconst current = lines.filter(row =>\n  !isNaN(row._date.getTime()) &&\n  row._date >= currentStart &&\n  row._date <= now\n);\n\nconst previous = lines.filter(row =>\n  !isNaN(row._date.getTime()) &&\n  row._date >= previousStart &&\n  row._date < currentStart\n);\n\nfunction summarize(periodRows) {\n  const revenue = periodRows.reduce(\n    (sum, row) => sum + row._revenue, 0\n  );\n\n  const orderIds = new Set(\n    periodRows\n      .map(row => row[FIELD.orderId])\n      .filter(id => id !== null && id !== undefined && id !== '')\n      .map(String)\n  );\n\n  const knownCostRows = periodRows.filter(\n    row => row._cost !== null\n  );\n\n  const cost = knownCostRows.reduce(\n    (sum, row) => sum + row._cost, 0\n  );\n\n  const profit = knownCostRows.length\n    ? knownCostRows.reduce((sum, row) => sum + row._profit, 0)\n    : null;\n\n  return {\n    revenue: money(revenue),\n    orders: orderIds.size,\n    averageOrderValue: orderIds.size\n      ? money(revenue / orderIds.size)\n      : 0,\n    costOfGoodsSold: knownCostRows.length\n      ? money(cost)\n      : null,\n    grossProfit: profit === null ? null : money(profit),\n    grossMarginPct: profit === null || revenue === 0\n      ? null\n      : money((profit / revenue) * 100),\n    lineItems: periodRows.length,\n    units: periodRows.reduce((sum, row) => sum + number(row[FIELD.quantity]), 0),\n  };\n}\n\nconst currentSummary = summarize(current);\nconst previousSummary = summarize(previous);\n\n// Calculate percentage growth against the previous period.\nconst revenueChangePct = previousSummary.revenue !== 0\n  ? money(\n      ((currentSummary.revenue - previousSummary.revenue) /\n        previousSummary.revenue) * 100\n    )\n  : null;\n\n// Rank products by discounted revenue in the current period.\nconst products = {};\n\nfor (const row of current) {\n  const name = row[FIELD.product] ?? 'Unknown product';\n\n  if (!products[name]) {\n    products[name] = { product: name, quantitySold: 0, revenue: 0 };\n  }\n\n  products[name].quantitySold += number(row[FIELD.quantity]);\n  products[name].revenue += row._revenue;\n}\n\nconst topProducts = Object.values(products)\n  .map(product => ({\n    ...product,\n    revenue: money(product.revenue),\n  }))\n  .sort((a, b) => b.revenue - a.revenue)\n  .slice(0, 5);\n\n// Return one structured output item.\nreturn [{\n  json: {\n    generatedAt: now.toISOString(),\n    periods: {\n      current: {\n        start: currentStart.toISOString(),\n        end: now.toISOString(),\n        ...currentSummary,\n      },\n      previous: {\n        start: previousStart.toISOString(),\n        end: currentStart.toISOString(),\n        ...previousSummary,\n      },\n    },\n    revenueChangePct,\n    topProducts,\n  },\n}];\n"
      },
