      "parameters": {
        "jsCode": "const req = $('Stock Request').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && String(r['Product ID'] || '').trim() !== '');\nconst norm = v => String(v === null || v === undefined ? '' : v).trim().toLowerCase();\nconst action = norm(req.action);\nconst pid = norm(req.product_id);\nconst name = norm(req.item_name);\nconst unitReq = norm(req.unit);\nconst now = $now.toFormat('yyyy-MM-dd HH:mm:ss');\nconst base = {\n  request_id: String(req.request_id || $execution.id),\n  source: req.source || 'Chat',\n  action: action,\n  timestamp: now,\n  product_id: String(req.product_id || '').trim(),\n  item_name: String(req.item_name || '').trim(),\n  previous_quantity: '',\n  change_quantity: '',\n  new_quantity: '',\n  unit: String(req.unit || '').trim(),\n  reorder_level: '',\n  low_stock: false,\n  alert_needed: false,\n  alert_flag: 'no',\n  route: 'rejected',\n  status: 'Rejected',\n  message: ''\n};\nfunction reject(msg, extra) {\n  return [{ json: Object.assign({}, base, extra || {}, { route: 'rejected', status: 'Rejected', alert_needed: false, message: msg }) }];\n}\nfunction listRows(list) {\n  return list.map(r => r['Product ID'] + ' ' + r['Item name'] + ' (' + r['Quantity'] + ' ' + r['Unit'] + ')').join(', ');\n}\nfunction parseNum(v) {\n  const s = String(v === null || v === undefined ? '' : v).replace(/,/g, '').replace(/[^0-9.\\-]/g, '');\n  if (s === '' || s === '-' || s === '.') return NaN;\n  return Number(s);\n}\nconst allowed = ['set', 'add', 'remove', 'create'];\nif (!allowed.includes(action)) return reject('Unknown action \"' + (req.action || '') + '\". Use set, add, remove or create.');\nconst qty = parseNum(req.quantity);\nif (!Number.isFinite(qty)) return reject('The quantity is missing or not a number. Ask the user for an exact numeric quantity.');\nif ((action === 'set' || action === 'create') && qty < 0) return reject('Stock cannot be negative.');\nif ((action === 'add' || action === 'remove') && qty <= 0) return reject('The quantity to ' + action + ' must be greater than zero.');\n\nif (action === 'create') {\n  if (!name) return reject('A product name is required to register a new product.');\n  if (!unitReq) return reject('A unit (e.g. loaf, litre, crate) is required to register a new product.');\n  const reorder = parseNum(req.reorder_level);\n  if (!Number.isFinite(reorder) || reorder < 0) return reject('A valid reorder level (0 or more) is required to register a new product.');\n  const dup = rows.filter(r => norm(r['Item name']) === name || (pid && norm(r['Product ID']) === pid));\n  if (dup.length) return reject('This product already exists: ' + listRows(dup) + '. No new row was created.');\n  let maxN = 0;\n  rows.forEach(r => { const m = String(r['Product ID']).match(/(\\d+)$/); if (m) maxN = Math.max(maxN, Number(m[1])); });\n  const newId = 'P' + String(maxN + 1).padStart(3, '0');\n  const lowNew = qty <= reorder;\n  return [{ json: Object.assign({}, base, {\n    route: 'create', status: 'Pending', product_id: newId, item_name: String(req.item_name).trim(),\n    previous_quantity: 0, change_quantity: qty, new_quantity: qty, unit: String(req.unit).trim(),\n    reorder_level: reorder, low_stock: lowNew, alert_needed: lowNew, alert_flag: lowNew ? 'yes' : 'no'\n  }) }];\n}\n\nlet matches = [];\nif (pid) matches = rows.filter(r => norm(r['Product ID']) === pid);\nelse if (name) matches = rows.filter(r => norm(r['Item name']) === name);\nelse return reject('No product was specified. Ask which product (Product ID or exact name).');\n\nif (matches.length === 0) {\n  const term = name || pid;\n  const partial = name ? rows.filter(r => norm(r['Item name']).includes(name) || name.includes(norm(r['Item name']))) : [];\n  return reject('Product not found: \"' + term + '\".' + (partial.length ? ' Possible matches: ' + listRows(partial) + '.' : '') + ' Ask whether to search again or register it as a new product. Nothing was changed.');\n}\nif (matches.length > 1) return reject('More than one inventory row matches: ' + listRows(matches) + '. Ask the user which Product ID to use. Nothing was changed.');\n\nconst row = matches[0];\nconst current = parseNum(row['Quantity']);\nif (!Number.isFinite(current)) return reject('The current stock for ' + row['Item name'] + ' in the sheet is not a valid number. Fix the sheet before updating.');\n\nconst generic = ['', 'unit', 'units', 'item', 'items', 'pc', 'pcs', 'piece', 'pieces'];\nconst rowUnit = norm(row['Unit']);\nif (!generic.includes(unitReq) && rowUnit && unitReq.slice(0, 3) !== rowUnit.slice(0, 3)) {\n  return reject('Unit mismatch: ' + row['Item name'] + ' is tracked in ' + row['Unit'] + ', but the request used \"' + req.unit + '\". Ask the user to confirm the quantity in ' + row['Unit'] + '.');\n}\n\nlet newQty;\nlet change;\nif (action === 'set') { newQty = qty; change = qty - current; }\nelse if (action === 'add') { newQty = current + qty; change = qty; }\nelse { newQty = current - qty; change = -qty; }\nnewQty = Math.round(newQty * 1000) / 1000;\nchange = Math.round(change * 1000) / 1000;\n\nconst ctx = { product_id: row['Product ID'], item_name: row['Item name'], unit: row['Unit'], previous_quantity: current, reorder_level: row['Reorder level'] };\nif (newQty < 0) {\n  return reject('Insufficient stock: only ' + current + ' ' + row['Unit'] + ' of ' + row['Item name'] + ' available, cannot remove ' + qty + '. Nothing was changed.', ctx);\n}\n\nconst reorderLevel = parseNum(row['Reorder level']);\nconst low = Number.isFinite(reorderLevel) && newQty <= reorderLevel;\nconst alreadyAlerted = norm(row['Low stock alerted']) === 'yes';\nreturn [{ json: Object.assign({}, base, ctx, {\n  route: 'update', status: 'Pending', change_quantity: change, new_quantity: newQty,\n  low_stock: low, alert_needed: low && !alreadyAlerted, alert_flag: low ? 'yes' : 'no'\n}) }];"
      },
