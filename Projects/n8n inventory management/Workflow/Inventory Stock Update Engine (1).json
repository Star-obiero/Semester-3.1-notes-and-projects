    {
      "parameters": {
        "jsCode": "const v = $('Validate and Calculate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && String(r['Product ID'] || '').trim() !== '');\nconst actual = rows.length === 1 ? Number(rows[0]['Quantity']) : NaN;\nconst ok = Number.isFinite(actual) && Math.abs(actual - Number(v.new_quantity)) < 0.0005;\nlet message;\nif (ok) {\n  message = 'Stock updated and verified: ' + v.item_name + ' went from ' + v.previous_quantity + ' to ' + v.new_quantity + ' ' + v.unit + '.';\n  if (v.low_stock) message += ' LOW STOCK WARNING: ' + v.new_quantity + ' ' + v.unit + ' left, reorder level is ' + v.reorder_level + ' ' + v.unit + '.';\n} else {\n  message = 'The update could NOT be verified. The sheet shows ' + (rows.length === 1 ? rows[0]['Quantity'] : rows.length + ' matching rows') + ' instead of ' + v.new_quantity + '. Check the sheet manually.';\n}\nreturn [{ json: Object.assign({}, v, { status: ok ? 'Success' : 'Failed', alert_needed: ok ? v.alert_needed : false, message: message }) }];"
      },
